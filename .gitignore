# Cargo workspace build output (anchored: a directory named `target` or
# `debug` elsewhere in the tree is source, not build output).
/target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC debug information written next to binaries built outside target/
*.pdb

# cargo mutants
**/mutants.out*/

# rustc internal compiler error dumps
rustc-ice-*.txt

# QA runner output (reports and screenshots, DESIGN §15.3)
qa-out/

# Claude Code agent worktrees and local settings
/.claude/worktrees/
/.claude/settings.local.json

# Editor and OS clutter
.idea/
.vscode/
.DS_Store
Thumbs.db

.serena/
